# Telegram Bot API (Instant setup via @BotFather, zero-cost, no business verification needed)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Meta WhatsApp Cloud API (Retained for future deployment)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_APP_SECRET=your_app_secret_here
PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp via Evolution API (self-hosted). When URL and instance name are set, WhatsApp uses Evolution
# instead of the Meta Cloud API. In the Evolution instance, set the webhook to
# http://<this-server>:8000/webhook/whatsapp (docker compose: http://app:8000/webhook/whatsapp).
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=your_instance_name

# Google Gemini (Free Tier LLM & Multimodal Audio STT from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Cheapest models: 3.1 flash-lite has the lowest text/output price, 3.5 flash-lite the lowest audio-input price
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite

# Optional Database URL (defaults to local SQLite: sqlite:///./rural_advisor.db)
# DATABASE_URL=sqlite:///./rural_advisor.db

# Vector retrieval (Qdrant + FastEmbed)
# Leave QDRANT_URL empty to use embedded on-disk Qdrant in data/qdrant_db/;
# set it (e.g. http://localhost:6333) to use the docker-compose Qdrant server.
# QDRANT_URL=
# Build the knowledge collection at startup when it is missing or empty (default: true)
QDRANT_AUTO_INGEST=true

# Real-data governance (default: true). When true, trades without an official
# NABARD / government benchmark (e.g. kirana, tailoring) return DATA_NOT_AVAILABLE
# instead of synthetic estimates. Set to false only for legacy local testing.
REAL_DATA_ONLY=true

# App Settings
BACKEND_INTERNAL_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Session signing key for officer logins: set a long random value on any deployed server
AUTH_SECRET_KEY=change_me_to_a_long_random_string
# Officer self-registration (docker-compose.yml turns it off for the deployed app)
ALLOW_PUBLIC_SIGNUP=true
